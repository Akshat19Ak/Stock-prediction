# Visual Studio workspace cache and per-user state; these files are machine-specific,
# regenerated by the IDE, and create noisy diffs with no value for source history.
.vs/

# Python bytecode cache directories; generated automatically when modules are imported,
# differ by Python version and execution path, and should not be versioned.
__pycache__/

# Compiled Python bytecode/object artifacts; build/runtime byproducts that are recreated
# from source and can cause stale behavior if shared across environments.
*.pyc
*.pyo
*.pyd

# Native extension/temp build outputs from packaging workflows; platform-specific binaries
# should be produced per machine or CI build, not stored in Git.
*.so

# Common Python packaging build directories and metadata outputs; generated during
# packaging/publishing and reproducible from project source and configuration.
build/
dist/
*.egg-info/

# Virtual environment folders usually contain thousands of installed dependency files;
# committing them bloats the repository and locks contributors to one local environment.
.venv/
venv/
env/
ENV/

# Environment variable files frequently store secrets (API keys, DB URLs, tokens).
# Keep them out of Git to prevent credential leaks; commit only safe templates instead.
.env
.env.*

# Notebook checkpoints are autosave snapshots and not canonical source;
# tracking them causes unnecessary churn in commits.
.ipynb_checkpoints/

# Test/coverage and static-analysis caches are local execution artifacts that are
# fully reproducible and should not pollute the repository history.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Logs are runtime diagnostics, often large and transient; they can accidentally include
# sensitive runtime data and are not required to reproduce code.
*.log

# OS-specific finder metadata files are generated by the operating system UI and add
# zero project value while creating cross-platform noise.
.DS_Store
Thumbs.db

# Local deep-dive documentation (not needed in source control).
SELF_README.md
temp/
